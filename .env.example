# ─────────────────────────────────────────────────────────────────────────────
# DATABASE (Supabase PostgreSQL via Prisma)
# ─────────────────────────────────────────────────────────────────────────────

# Pooled connection (PgBouncer) — used at runtime by Prisma
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection — used by Prisma migrations (bypasses PgBouncer)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL (Resend)
# ─────────────────────────────────────────────────────────────────────────────

# Your Resend API key — get it at https://resend.com
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# Admin email address to receive inquiry notifications
ADMIN_EMAIL="you@example.com"

# Sender address — must be a verified domain in Resend
# Format: "Display Name <email@yourdomain.com>"
FROM_EMAIL="Portfolio <inquiries@yourdomain.com>"

# ─────────────────────────────────────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────────────────────────────────────

# Allowed frontend origin for CORS (no trailing slash)
FRONTEND_ORIGIN="http://localhost:5500"

# Secret key to protect admin API routes (min 24 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY="replace-with-a-64-char-hex-secret-generated-locally"

# ─────────────────────────────────────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────────────────────────────────────

PORT=3000
NODE_ENV="development"
